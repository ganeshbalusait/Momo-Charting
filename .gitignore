# Virtual environments
# These rules predate nothing useful: .venv was already COMMITTED when they were
# added, and gitignore never applies to tracked files - so ~11,600 venv files
# kept showing up dirty after every run until they were untracked with
# `git rm -r --cached .venv`. The files stay on disk; git just stops following
# them. Recreate a fresh checkout's venv from requirements.txt.
.venv/
.venv-*/
venv/
env/
ENV/

# Testing and tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Environment files
.env
.env.*
!.env.example


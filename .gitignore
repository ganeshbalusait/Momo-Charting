frontend/dist/
frontend/build/
frontend/.vite/
.pnpm-store/
coverage/

# Live data and secrets must never be git-managed: a checkout-touching
# operation truncated the live trades.db on 2026-08-10 BECAUSE it was tracked.
*.db
*.db-shm
*.db-wal
.pnpm-store/
artifacts/schwab_token.*.json

# Scratch dir: holds captured browser profiles (cookies, session tokens)
tmp/

# Machine-local runtime state under artifacts/. All of this is regenerated by
# the server or written as a safety copy - none of it is source, and the DB
# backup below is exactly the kind of live data the warning above is about.
artifacts/*.log.err
artifacts/scanner_watchdog.lock
artifacts/db-backup-*/
artifacts/oi_chain_cache/
artifacts/schwab_stream_history/
artifacts/schwab_stream_chart_history.json.gz
artifacts/watchlist.backup-*.txt

# Daily generated OI level exports (one file per session, named by date).
artifacts/thinkscript/

# Local scratch: pre-edit .bak copies, and a nested working copy of the project.
frontend/.restyle-backup/
Momo-Chart/

EXECUTION_MODE=paper
ALLOW_LIVE_TRADING=false
ENFORCE_DAILY_LOSS_LIMIT=false
TRADE_ALL_SESSIONS=true
STOCK_AUTO_OI_CONFIRMATION_MAX_AGE_SECONDS=300
ALPACA_PAPER_KEY_ID=your_paper_key
ALPACA_PAPER_SECRET_KEY=your_paper_secret
ALPACA_DEFAULT_PAPER_LABEL=Main Paper
ALPACA_LIVE_KEY_ID=your_live_key
ALPACA_LIVE_SECRET_KEY=your_live_secret
ALPACA_ACCOUNT_PROFILES=paper3,paper4,paper5
ALPACA_PROFILE_PAPER2_LABEL=Mag7 stocks
ALPACA_PROFILE_PAPER2_KEY_ID=your_second_paper_key
ALPACA_PROFILE_PAPER2_SECRET_KEY=your_second_paper_secret
ALPACA_PROFILE_PAPER3_LABEL=Mag7 OPTION
ALPACA_PROFILE_PAPER3_KEY_ID=your_third_paper_key
ALPACA_PROFILE_PAPER3_SECRET_KEY=your_third_paper_secret
ALPACA_PROFILE_PAPER4_LABEL=Watchlist stocks
ALPACA_PROFILE_PAPER4_KEY_ID=your_fourth_paper_key
ALPACA_PROFILE_PAPER4_SECRET_KEY=your_fourth_paper_secret
ALPACA_PROFILE_PAPER5_LABEL=Watchlist option
ALPACA_PROFILE_PAPER5_KEY_ID=your_fifth_paper_key
ALPACA_PROFILE_PAPER5_SECRET_KEY=your_fifth_paper_secret
OPTION_ACCOUNT_PROFILE=paper3
WATCHLIST_OPTION_ACCOUNT_PROFILE=paper5
OPTION_ACCOUNT_LABEL=Mag7 OPTION TRADE
OPTION_ACCOUNT_LABEL2=Mag7 Stock trade
OPTION_ACCOUNT_LABEL3=Mag7 OPTION TRADE
OPTION_ACCOUNT_LABEL4=Watchlist Stock trade
OPTION_ACCOUNT_LABEL5=Watchlist OPTION TRADE
ACTIVE_ALPACA_PROFILE=paper4
ALPACA_DATA_FEED=iex
ALPACA_STREAMING_ENABLED=true
ALPACA_TRADE_UPDATES_ENABLED=true
MARKET_DATA_PROVIDER=alpaca
SCHWAB_CLIENT_ID=your_schwab_app_key
SCHWAB_CLIENT_SECRET=your_schwab_app_secret
SCHWAB_REDIRECT_URI=https://127.0.0.1/
SCHWAB_TRADING_CLIENT_ID=your_schwab_trading_app_key
SCHWAB_TRADING_CLIENT_SECRET=your_schwab_trading_app_secret
SCHWAB_TRADING_REDIRECT_URI=https://127.0.0.1/
SCHWAB_TRADING_TOKEN_PATH=artifacts/schwab_trading_token.json
SCHWAB_REFRESH_TOKEN=
SCHWAB_ACCESS_TOKEN=
SCHWAB_EXTENDED_HOURS=true
TRADIER_ACCESS_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
SCANNER_UNIVERSE=AAPL,AMD,AMZN,AVGO,COIN,CRWD,META,MSFT,NVDA,PLTR,QQQ,SMCI,SOFI,TSLA,UBER
STOCK_SCANNER_AUTO_INTERVAL_SECONDS=60
STOCK_SCANNER_DEEP_BATCH_SIZE=12
STOCK_SCANNER_HOT_LANE_SIZE=6
OI_MAG7_AUTO_INTERVAL_SECONDS=15
OI_MAG7_CONTINUOUS_PAUSE_SECONDS=1
OI_WATCHLIST_AUTO_INTERVAL_SECONDS=30
OI_WATCHLIST_BATCH_SIZE=25
OI_WATCHLIST_WORKER_COUNT=5
OI_WATCHLIST_CONTINUOUS_PAUSE_SECONDS=1
# OI Finder daily history: weekdays after the market closes, sequential only.
# 15 seconds per symbol keeps the 400-symbol archival pass deliberately slow.
OI_FINDER_SNAPSHOT_ENABLED=true
OI_FINDER_SNAPSHOT_HOUR_ET=16
OI_FINDER_SNAPSHOT_MINUTE_ET=15
OI_FINDER_SNAPSHOT_INTERVAL_SECONDS=15
AGGRESSIVE_MORNING_MODE_ENABLED=true
AGGRESSIVE_MORNING_MINUTES=90
AGGRESSIVE_MORNING_MIN_RVOL=1.2
MIN_SESSION_CHANGE_PCT=1.0
# Runtime health agent. It may restart dead worker threads, but never changes strategy code.
RUNTIME_WATCHDOG_ENABLED=true
RUNTIME_WATCHDOG_AUTO_RECOVER=true
RUNTIME_WATCHDOG_INTERVAL_SECONDS=15
RUNTIME_WATCHDOG_STALE_MULTIPLIER=4.0

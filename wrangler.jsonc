// Deploy config for agxtrade.com — the public marketing page.
//
// The site is a static-assets Worker (no server code): Cloudflare serves the
// files in web/ directly, which is why the dashboard reports "Metrics is
// unavailable for Workers with only static assets".
//
// This file exists so Workers Builds can deploy on a push to main. The build
// requires "name" to match the Worker in the Cloudflare dashboard exactly —
// if the Worker is ever renamed, change it here too or every build fails.
//
// Not related to app.agxtrade.com, which is the trading app served over the
// cloudflared tunnel from the nested AgenticAI-Trading 2 repo.
{
  "name": "silent-dream-af05",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./web"
  }
}
